{
  "name": "novel-tool",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first Chinese long-form novel editing workstation.",
  "main": ".vite/build/index.js",
  "scripts": {
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:lockfile-safety": "node scripts/check-lockfile-safety.mjs",
    "rebuild:node": "npm rebuild better-sqlite3 --foreground-scripts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "axios": "1.15.2",
    "better-sqlite3": "12.8.0",
    "chardet": "2.1.1",
    "diff": "8.0.4",
    "fast-xml-parser": "5.7.1",
    "fflate": "0.8.2",
    "iconv-lite": "0.7.2",
    "parse5": "8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.3",
    "@electron-forge/maker-dmg": "7.8.3",
    "@electron-forge/maker-squirrel": "7.8.3",
    "@electron-forge/maker-zip": "7.8.3",
    "@electron-forge/plugin-vite": "7.8.3",
    "@electron/fuses": "2.1.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.1.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.10",
    "vitest": "4.1.2"
  },
  "overrides": {
    "@electron/rebuild": "4.0.4"
  }
}
