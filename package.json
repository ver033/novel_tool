{
  "name": "novel-tool",
  "productName": "墨枢",
  "version": "1.4.0",
  "private": true,
  "description": "Local-first Chinese long-form novel editing workstation.",
  "main": ".vite/build/index.js",
  "scripts": {
    "predev": "npm run rebuild:electron",
    "dev": "electron-forge start",
    "prebuild": "npm run rebuild:electron",
    "build": "electron-forge package",
    "prepackage": "npm run rebuild:electron",
    "package": "electron-forge package",
    "premake": "npm run rebuild:electron",
    "make": "electron-forge make",
    "premake:windows": "npm run rebuild:electron",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "pretest": "npm run rebuild:node",
    "test": "vitest run --testTimeout=30000 --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "tsc --noEmit",
    "check:lockfile-safety": "node scripts/check-lockfile-safety.mjs",
    "rebuild:node": "npm rebuild better-sqlite3 --foreground-scripts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tiptap/extension-link": "3.22.4",
    "@tiptap/extension-text-style": "3.22.4",
    "@tiptap/extension-underline": "3.22.4",
    "@tiptap/extension-unique-id": "3.22.4",
    "@tiptap/extensions": "3.22.4",
    "@tiptap/pm": "3.22.4",
    "@tiptap/react": "3.22.4",
    "@tiptap/starter-kit": "3.22.4",
    "axios": "1.15.2",
    "better-sqlite3": "12.8.0",
    "chardet": "2.1.1",
    "diff": "8.0.4",
    "fast-xml-parser": "5.7.1",
    "fflate": "0.8.2",
    "iconv-lite": "0.7.2",
    "parse5": "8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "4.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.8.3",
    "@electron-forge/maker-dmg": "7.8.3",
    "@electron-forge/maker-squirrel": "7.8.3",
    "@electron-forge/maker-zip": "7.8.3",
    "@electron-forge/plugin-vite": "7.8.3",
    "@electron/fuses": "2.1.1",
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "41.1.1",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "vite": "8.0.10",
    "vitest": "4.1.2"
  },
  "overrides": {
    "@electron/rebuild": "4.0.4",
    "uuid": "14.0.0"
  }
}
